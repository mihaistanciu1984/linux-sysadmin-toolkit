# Public example only. Do not place real secrets in this file.

# Recommended format using a dedicated PBS API token:
# user@realm!token@server:datastore
PBS_REPOSITORY="backup-client@pbs!linux-host@pbs.example.com:datastore-example"

# Local file containing only the API token secret.
PBS_PASSWORD_FILE="/etc/proxmox-backup-client/token.secret"

# Required only when the PBS certificate cannot be validated through
# the operating system CA certificates.
PBS_FINGERPRINT=""

# Backup group will be created as host/linux-config-example.
BACKUP_ID="linux-config-example"

# Directory included in the pxar archive.
SOURCE_DIR="/etc"

# Resulting archive name: etc.pxar
ARCHIVE_NAME="etc"

LOG_FILE="/var/log/proxmox-backup-client/config-backup.log"
LOCK_FILE="/run/lock/auto-pbs-backup.lock"